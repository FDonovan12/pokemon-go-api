{
  "name": "pogo-gamemaster-parser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "generate": "tsx src/generateRawData.ts",
    "intermediate": "tsx src/generateIntermediateData.ts",
    "update": "npm run build && node dist/src/checkAndUpdate.js",
    "dev": "npm run generate && npm run intermediate && tsx watch src/checkAndUpdate.ts",
    "prepare": "npm run generate && npm run intermediate"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "quicktype-core": "^23.2.6",
    "tsx": "^4.21.0",
    "utilitish": "^0.0.25"
  }
}
