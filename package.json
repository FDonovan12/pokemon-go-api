{
  "name": "pogo-gamemaster-parser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "generate": "npm run build && node dist/saveRawData.js",
    "update": "npm run build && node dist/checkAndUpdate.js",
    "dev": "tsc --watch",
    "run": "node dist/checkAndUpdate.js",
    "run:watch": "node --watch dist/checkAndUpdate.js",
    "prepare": "npm run generate"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "quicktype-core": "^23.2.6",
    "utilitish": "^0.0.5"
  }
}
