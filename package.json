    "dev": "npm run generate && tsx watch src/checkAndUpdate.ts",
    "prepare": "npm run generate"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "quicktype-core": "^23.2.6",
    "tsx": "^4.21.0",
    "utilitish": "^0.0.6"
  }
}
