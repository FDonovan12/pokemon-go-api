{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",

        "rootDirs": ["src", "generated"],
        "outDir": "dist",

        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,

        "types": ["node"]
    },
    "include": ["src", "generated"]
}
