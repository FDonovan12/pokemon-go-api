{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "paths": {
            "#generated/*": ["./generated/*"]
        },
        "rootDir": ".",
        "rootDirs": ["src", "generated"],
        "outDir": "dist",

        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,

        "types": ["node"]

        // "paths": {
        //     "#generated/*": ["./generated/*"]
        // }
    },
    "include": ["src", "generated"]
}
