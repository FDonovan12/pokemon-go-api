{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDirs": ["src", "generated"],
        "outDir": "dist",

        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,

        "types": ["node"],

        "paths": {
            "@generated/*": ["./generated/*"]
        }
    },
    "include": ["src", "generated"]
}
